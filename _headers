# Cloudflare Pages headers.
#
# sw.js must never be served stale from the edge — clients would keep running
# an old CACHE_VERSION and never pick up a deploy.
#
# catechisms.json is deliberately network-first in the service worker so
# regenerated data ships without a version bump; an edge cache in front of it
# defeats that entirely.

/sw.js
  Cache-Control: no-cache

/catechisms.json
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/
  Cache-Control: no-cache

# Fingerprinted-by-content assets: safe to cache hard.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
